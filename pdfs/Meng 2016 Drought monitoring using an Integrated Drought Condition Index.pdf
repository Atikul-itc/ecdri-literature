               <rdf:li>Drought; MODIS; TRMM precipitation; Principle component analysis; SPEI; Drought index; Drought index weighting</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Drought monitoring using an Integrated Drought Condition Index (IDCI) derived from multi-sensor remote sensing data</rdf:li>
            </rdf:Alt>
