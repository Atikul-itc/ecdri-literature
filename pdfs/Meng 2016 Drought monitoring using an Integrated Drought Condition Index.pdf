         <pdf:Keywords>Drought; MODIS; TRMM precipitation; Principle component analysis; SPEI; Drought index; Drought index weighting</pdf:Keywords>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
